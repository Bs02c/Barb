# Copiar a .env.local y rellenar. En local, los valores de Supabase salen de `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor: salta RLS. Nunca en código de cliente ni con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Dominio raíz sobre el que se resuelven los subdominios de las barberías.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Solo servidor (fase 5).
RESEND_API_KEY=
