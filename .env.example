# Copiar a .env.local y rellenar. En local, los valores de Supabase salen de `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor: salta RLS. Nunca en código de cliente ni con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Dominio raíz sobre el que se resuelven los subdominios de las barberías.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Solo servidor (fase 5). Correo: `outbox` escribe en .outbox/ (desarrollo y tests); `resend` envía de verdad.
EMAIL_TRANSPORT=
# Remitente, p. ej. Reservas <onboarding@resend.dev> en pruebas.
EMAIL_FROM=
RESEND_API_KEY=

# --- PostgreSQL propio (spec 005, ADR-017) ---
# Solo servidor. Rol app_login (sin privilegios propios; cambia a authenticated o service_role por transacción).
# En local: postgres://app_login:<contraseña>@127.0.0.1:54329/barberias
DATABASE_URL=
# Solo servidor. Rol auth_login (pool de Better Auth, esquema identity).
AUTH_DATABASE_URL=
# Solo scripts locales (db:reset, seed, alta de barberías) y tests de integración. NUNCA en el contenedor app.
DATABASE_OWNER_URL=
# Solo servidor. Firma de las cookies de sesión: 32 caracteres o más (`openssl rand -base64 32`).
BETTER_AUTH_SECRET=
# Intentos de login por IP cada 15 min. 5 en servidores; en local todos comparten un cubo (sin Caddy), así que 50.
AUTH_SIGNIN_MAX_ATTEMPTS=50
