{
  "name": "reservas-barberias",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "docker compose -f compose.dev.yml exec -T -u postgres db pg_prove -d barberias --ext .sql /tests/",
    "db:start": "docker compose -f compose.dev.yml up -d --wait db",
    "db:reset": "node --env-file=.env.local scripts/db-reset.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "barbershop:create": "node --env-file=.env.local scripts/create-barbershop.mts",
    "perf:ttfb": "node scripts/measure-ttfb.mjs",
    "db:stop": "docker compose -f compose.dev.yml stop db",
    "db:migrate": "docker compose -f compose.dev.yml run --rm migrate up"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
